        start = time.perf_counter()

        try:

            result = post_json(
                LLM_URL,
                {
                    "question": question,
                    "context": context
                }
            )

            latency = time.perf_counter() - start

            st.session_state.llm_result = result
            st.session_state.llm_latency = round(
                latency,
                3
            )

        except Exception as e:

            st.error(
                f"Unable to contact LLM service: {e}"
            )

    result = st.session_state.llm_result

    if result:

        st.markdown("---")

        # -------------------------------------------------
        # Prompt
        # -------------------------------------------------

        st.subheader(
            "Prompt Sent to LLM"
        )

        prompt = f"""Answer the user's question using only the provided context.

Context:
{context}

Question:
{question}

Give a concise answer based on the context.
"""

        st.code(
            prompt,
            language="text"
        )

        # -------------------------------------------------
        # Response
        # -------------------------------------------------

        st.subheader(
            "LLM Response"
        )

        st.markdown(
            f"""
            <div class="answer-card">

                <div class="answer-label">
                    Generated Response
                </div>

                <div class="answer-text">
                    {result.get(
                        "answer",
                        "No response returned."
                    )}
                </div>

            </div>
            """,
            unsafe_allow_html=True
        )

        # -------------------------------------------------
        # LLM metrics
        # -------------------------------------------------

        lm1, lm2, lm3 = st.columns(3)

        with lm1:

            st.metric(
                "Model",
                "Qwen 1.5B"
            )

        with lm2:

            st.metric(
                "Provider",
                "Ollama"
            )

        with lm3:

            st.metric(
                "Latency",
                f'{st.session_state.llm_latency} sec'
            )

        # -------------------------------------------------
        # LLM flow
        # -------------------------------------------------

        st.markdown("---")

        st.subheader(
            "LLM Processing Flow"
        )

        st.markdown(
            """
            <div class="pipeline">

                <div class="pipeline-step">
                    Question
                </div>

                <div class="pipeline-arrow">
                    +
                </div>

                <div class="pipeline-step">
                    Retrieved Context
                </div>

                <div class="pipeline-arrow">
                    →
                </div>

                <div class="pipeline-step">
                    Prompt
                </div>

                <div class="pipeline-arrow">
                    →
                </div>

                <div class="pipeline-step">
                    Ollama
                </div>

                <div class="pipeline-arrow">
                    →
                </div>

                <div class="pipeline-step">
                    LLM
                </div>

                <div class="pipeline-arrow">
                    →
                </div>

                <div class="pipeline-step">
                    Response
                </div>

            </div>
            """,
            unsafe_allow_html=True
        )
